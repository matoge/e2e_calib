{
  "name": "pandaset_3cam_corr_multicam_5dof",
  "description": "LEFT/RIGHT BA with 5-DoF (ωx, ωy, tx, ty, Δfx) — adds lateral mount translation to the 3-DoF baseline to see if t-bias absorbs residual that ω alone leaves.",
  "model": {
    "ckpt": "experiments/ps_multicam_corr_vcam_clspose_fxfy_100ep/best_model.pt",
    "img_size": 128,
    "in_channels": 3,
    "n_layers": 4,
    "use_convnext": true,
    "use_frustum": true,
    "deform_mode": "sl",
    "use_frame_pose": true,
    "frame_pose_dof": 7,
    "pose_frame": "vcam"
  },
  "data": {
    "root": "/mnt/nvme6t/pandaset",
    "scenes": ["001", "002", "003", "005", "011", "015", "017", "023", "027", "035"],
    "frames": [30],
    "cams": ["left_camera", "right_camera"]
  },
  "ba": {
    "tile_size": 256,
    "model_input_size": 128,
    "tile_stride": 128,
    "max_pts_per_tile": 256,
    "min_pts_per_tile": 16,
    "param": "5dof",
    "damping": 1e-3
  },
  "output": {
    "corrections_json": "configs/ba/pandaset_3cam_corrections_multicam_5dof.json",
    "vis_dir": "experiments/_cache_check/ps_3cam_ba_check_multicam_5dof",
    "vis_scenes": ["001", "017", "035"],
    "vis_frames": [10, 30, 50]
  }
}
